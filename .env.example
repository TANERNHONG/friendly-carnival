# Copy to .env and fill in. Leave the eBay keys empty to run on simulated DEMO data.

# --- eBay Browse API (https://developer.ebay.com -> My Account -> Application Keys -> Production) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
# Marketplace searched by default (EBAY_US, EBAY_GB, EBAY_AU, EBAY_SG, ...). Rows in the price list can override it.
EBAY_MARKETPLACE=EBAY_US
# Shipping estimates are requested for this destination.
SHIP_TO_COUNTRY=SG
SHIP_TO_ZIP=
# Default Browse API quota is 5,000 calls/day; Carnival stops calling eBay when this is reached.
EBAY_DAILY_CALL_BUDGET=5000

# --- Telegram (message @BotFather -> /newbot) ---
TELEGRAM_BOT_TOKEN=
# Optional: lock the bot to one chat id. If empty, the first chat that sends /start is bound.
TELEGRAM_CHAT_ID=

# --- Schedules ---
SCAN_INTERVAL_HOURS=3
TRACK_INTERVAL_MINUTES=5
# Minutes before the end of a tracked auction to send an alert.
ALERT_MINUTES=60,15,5
MAX_RESULTS_PER_KEYWORD=100
MAX_ACTIVE_TRACKED=40
# Deals ending within this many hours are tracked automatically.
AUTO_TRACK_HOURS=24

# --- Price list maths ---
# Landed cost = (bid + shipping) * (1 + IMPORT_TAX_PCT/100), converted to SGD.
# Singapore GST (9%) is collected by eBay on low-value imports; set 0 if your targets exclude it.
IMPORT_TAX_PCT=9
NEAR_PCT=10

# --- App ---
HOST=127.0.0.1
PORT=8787
# DEMO_MODE=1 forces simulated data even when eBay keys are present.
DEMO_MODE=0
